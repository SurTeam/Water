#!/usr/bin/env bash
set -euo pipefail
# Stub xcrun for cross-compiling macOS GUI targets on Linux.
# Handles the calls Zed's build scripts make:
#   xcrun --sdk macosx --show-sdk-path            → prints a sysroot-ish path
#   xcrun -sdk macosx metal ... -o out.air        → empty .air
#   xcrun -sdk macosx metallib in.air -o out.lib  → empty .metallib
zig_home="$(dirname "$(dirname "$(command -v zig)")")"

# --show-sdk-path: print the zig libc dir (headers live there)
if [[ "$*" == *"--show-sdk-path"* ]]; then
  echo "$zig_home/lib/libc"
  exit 0
fi

out=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [[ -n "$out" ]]; then
  : > "$out"
fi
exit 0