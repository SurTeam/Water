{
  "features": {
    "mouse_reporting": true,
    "bracketed_paste": true,
    "selection": true
  },
  "theme": {
    "terminal_background": "#0b1117",
    "terminal_foreground": "#d8e2ef",
    "selection_background": "#335d7a",
    "cursor_foreground": "#0b1117",
    "cursor_background": "#9cc8ef",
    "inactive_cursor": "#9cc8ef",
    "inverse_foreground": "#e6eef7",
    "inverse_background": "#335d7a",
    "pane_background": "#101820",
    "active_pane_border": "#61b3ff",
    "inactive_pane_border": "#364656",
    "chrome_background": "#0f161e",
    "tab_active_background": "#29435c",
    "tab_inactive_background": "#1d2733",
    "tab_add_background": "#263544",
    "ui_foreground": "#e6eef7"
  },
  "terminal": {
    "scrollback_lines": 10000,
    "max_total_scrollback_lines": 100000,
    "font_family": "Menlo",
    "font_size": 14.0,
    "line_height": 18.0
  }
}
